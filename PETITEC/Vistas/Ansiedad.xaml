<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PETITEC.Vistas.Ansiedad"
             NavigationPage.HasNavigationBar="False">
    <Grid BackgroundColor="#79CDE0">
        <StackLayout VerticalOptions="Center"
         Margin="20,0,20,0"
         Spacing="0">
            <Label Text="¿Sufre (nombre de la mascota) de ansiedad"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   FontSize="30"
                   LineBreakMode="WordWrap"
                   Margin="30,0,0,0"/>
            <Label Text="por separacion cuando"
       FontAttributes="Bold"
       TextColor="White"
       HorizontalOptions="Center"
       FontSize="30"
       LineBreakMode="WordWrap"
       Margin="0"/>
            <Label Text="sales de casa?"
       FontAttributes="Bold"
       TextColor="White"
       HorizontalOptions="Center"
       FontSize="30"
       LineBreakMode="WordWrap"
       Margin="0"/>
            <Button Text="Si" 
                Clicked="btnSi_Clicked" 
                x:Name="btnSi"
                CornerRadius="30"
                FontSize="30"
                TextTransform="None"
                BorderColor="#FFDA18"
                BorderWidth="3"
                BackgroundColor="#00FFFFFF"
                Margin="0,30,0,0"/>
            <Button Text="No" 
                Clicked="btnNo_Clicked"
                x:Name="btnNo"
                CornerRadius="30"
                FontSize="30"
                TextTransform="None"
                BorderColor="#FFDA18"
                BorderWidth="3"
                BackgroundColor="#00FFFFFF"
                Margin="0,30,0,0"/>
            <Button Text="Algunas veces" 
                Clicked="btnAlgunas_veces_Clicked"
                x:Name="btnAlgunas_veces"
                CornerRadius="30"
                FontSize="30"
                TextTransform="None"
                BorderColor="#FFDA18"
                BorderWidth="3"
                BackgroundColor="#00FFFFFF"
                Margin="0,30,0,0"/>
            <Button Text="  Continuar   >"
        CornerRadius="30"
        FontSize="30"
        FontAttributes="Bold"
        Margin="30,100,30,0"
        BackgroundColor="#D9FFDA18"
        Clicked="BotonContinuar_Clicked"
        IsVisible="false"
        x:Name="BotonContinuar"/>
        </StackLayout>
    </Grid>
</ContentPage>