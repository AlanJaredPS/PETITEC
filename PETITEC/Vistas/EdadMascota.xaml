<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PETITEC.Vistas.EdadMascota"
             NavigationPage.HasNavigationBar="False">
    <Grid BackgroundColor="#79CDE0">
        <StackLayout VerticalOptions="Center"
            Margin="20,90,20,0"
            Spacing="0">
            <Label Text="¿Que edad tiene tu"
           FontAttributes="Bold"
           TextColor="White"
           HorizontalOptions="Center"
           FontSize="35"
           LineBreakMode="WordWrap"
           Margin="0"/>
            <Label Text="mascota?"
           FontAttributes="Bold"
           TextColor="White"
           HorizontalOptions="Center"
           FontSize="35"
           LineBreakMode="WordWrap"
           Margin="0,0,0,10"/>
            <Button Text="0-6 meses" 
                    Clicked="btn6Meses_Clicked" 
                    x:Name="btn6Meses"
                    CornerRadius="30"
                    FontSize="30"
                    TextTransform="None"
                    BorderColor="#FFDA18"
                    BorderWidth="3"
                    BackgroundColor="#00FFFFFF"
                    Margin="0,10,0,0"/>
            <Button Text="0-12 meses" 
                    Clicked="btn12Meses_Clicked"
                    x:Name="btn12Meses"
                    CornerRadius="30"
                    FontSize="30"
                    TextTransform="None"
                    BorderColor="#FFDA18"
                    BorderWidth="3"
                    BackgroundColor="#00FFFFFF"
                    Margin="0,30,0,0"/>
            <Button Text="1-2 años" 
                    Clicked="btn2años_Clicked" 
                    x:Name="btn2años"
                    CornerRadius="30"
                    FontSize="30"
                    TextTransform="None"
                    BorderColor="#FFDA18"
                    BorderWidth="3"
                    BackgroundColor="#00FFFFFF"
                    Margin="0,30,0,0"/>
            <Button Text="2-7 años" 
                    Clicked="btn7años_Clicked"
                    x:Name="btn7años"
                    CornerRadius="30"
                    FontSize="30"
                    TextTransform="None"
                    BorderColor="#FFDA18"
                    BorderWidth="3"
                    BackgroundColor="#00FFFFFF"
                    Margin="0,30,0,0"/>
            <Button Text="Mas de 7 años" 
                    Clicked="btn7añosMas_Clicked"
                    x:Name="btn7añosMas"
                    CornerRadius="30"
                    FontSize="30"
                    TextTransform="None"
                    BorderColor="#FFDA18"
                    BorderWidth="3"
                    BackgroundColor="#00FFFFFF"
                    Margin="0,30,0,0"/>
            <Button Text="  Continuar   >"
            x:Name="BotonContinuar"
            CornerRadius="30"
            FontSize="30"
            FontAttributes="Bold"
            Margin="30,80,30,30"
            BackgroundColor="#D9FFDA18"
            Clicked="BotonContinuar_Clicked"
            IsVisible="false"/>
        </StackLayout>
    </Grid>
</ContentPage>