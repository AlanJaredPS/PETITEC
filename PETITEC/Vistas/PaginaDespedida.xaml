<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PETITEC.Vistas.PaginaDespedida"
             NavigationPage.HasNavigationBar="False">
    <Grid BackgroundColor="#79CDE0">
        <StackLayout VerticalOptions="Center"
                  Margin="20"
                  Spacing="0">
            <Label Text="¡Tu mascota esta en"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                FontSize="30"
                LineBreakMode="WordWrap"
                Margin="0,200,0,0"/>
            <Label Text="buenas manos!"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   FontSize="30"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,0"/>
            <Button Text="  Continuar   >"
                 CornerRadius="30"
                 FontSize="30"
                 FontAttributes="Bold"
                 Margin="30,100,30,0"
                 BackgroundColor="#D9FFDA18"
                 Clicked="BotonFin_Clicked"
                 x:Name="BotonFin"/>
        </StackLayout>
    </Grid>
</ContentPage>