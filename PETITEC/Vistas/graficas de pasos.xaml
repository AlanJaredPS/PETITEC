<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Forms;assembly=Microcharts.Forms"
             x:Class="PETITEC.Vistas.graficas_de_pasos"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#79CDE0" Padding="20">
        <StackLayout Spacing="20">

            <!-- Título de Resumen -->
            <Label Text="Resumen"
               FontAttributes="Bold"
               FontSize="24"
               TextColor="White"
               HorizontalOptions="Center"/>

            <!-- Tarjeta de Conteo de Pasos -->
            <Frame BackgroundColor="#A7E4ED" CornerRadius="15" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <Label Text="Conteo de pasos"
                       FontSize="14"
                       TextColor="White"
                       Grid.Row="0"
                       HorizontalOptions="Start"/>

                    <!-- Gráficos para día, semana y mes -->
                    <StackLayout Grid.Row="1" Orientation="Vertical" Spacing="10" VerticalOptions="Center">

                        <!-- Pasos por día -->
                        <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                            <Label Text="Hoy:" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                            <microcharts:ChartView x:Name="StepCountChartDia"
                                               HeightRequest="80" 
                                               WidthRequest="80" />
                        </StackLayout>

                        <!-- Pasos por semana -->
                        <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                            <Label Text="Esta semana:" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                            <microcharts:ChartView x:Name="StepCountChartSemana"
                                               HeightRequest="80" 
                                               WidthRequest="80" />
                        </StackLayout>

                        <!-- Pasos por mes -->
                        <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                            <Label Text="Este mes:" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                            <microcharts:ChartView x:Name="StepCountChartMes"
                                               HeightRequest="80" 
                                               WidthRequest="80" />
                        </StackLayout>

                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Tarjeta de Distancia de Pasos -->
            <Frame BackgroundColor="#A7E4ED" CornerRadius="15" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <Label Text="Distancia de pasos"
                       FontSize="14"
                       TextColor="White"
                       Grid.Row="0"
                       HorizontalOptions="Start"/>

                    <!-- Gráficos para día, semana y mes -->
                    <StackLayout Grid.Row="1" Orientation="Vertical" Spacing="10" VerticalOptions="Center">

                        <!-- Distancia por día -->
                        <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                            <Label Text="Hoy:" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                            <microcharts:ChartView x:Name="StepDistanceChartDia"
                                               HeightRequest="80" 
                                               WidthRequest="80" />
                        </StackLayout>

                        <!-- Distancia por semana -->
                        <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                            <Label Text="Esta semana:" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                            <microcharts:ChartView x:Name="StepDistanceChartSemana"
                                               HeightRequest="80" 
                                               WidthRequest="80" />
                        </StackLayout>

                        <!-- Distancia por mes -->
                        <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                            <Label Text="Este mes:" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                            <microcharts:ChartView x:Name="StepDistanceChartMes"
                                               HeightRequest="80" 
                                               WidthRequest="80" />
                        </StackLayout>

                    </StackLayout>
                </Grid>
            </Frame>

        </StackLayout>
    </Grid>

</ContentPage>